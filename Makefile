# Compiler and archiving tools
CC     := gcc
AR      = ar
ARFLAGS = rcs
CFLAGS  = -Wall -Wextra -O2 -pthread -fPIC -MMD -MP

# Directories
SRC_DIR   = src
INC_DIR   = include
BUILD_DIR = build

# Target library name
TARGET = $(BUILD_DIR)/liballocator.a

# Automatically find all .c files in the src directory
SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))
DEPS = $(OBJS:.o=.d)

all: $(BUILD_DIR) $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(OBJS)
	rm -f $@
	$(AR) $(ARFLAGS) $@ $(OBJS)


$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR) build-ubsan build-tsan

# Tests
TEST_DIR    = tests
TEST_SRCS   = $(wildcard $(TEST_DIR)/*.c)
TEST_HDRS   = $(wildcard $(TEST_DIR)/*.h) $(wildcard $(SRC_DIR)/*.h) $(wildcard $(INC_DIR)/*.h)
TEST_BIN    = $(BUILD_DIR)/run_tests
TEST_CFLAGS = -Wall -Wextra -O2 -g -pthread -std=gnu11

$(TEST_BIN): $(TEST_SRCS) $(TEST_HDRS) $(TARGET)
	$(CC) $(TEST_CFLAGS) $(TEST_SRCS) $(TARGET) -o $@

# make test              runs the whole suite
test: $(TEST_BIN)
	./$(TEST_BIN)

SAN_UB = -fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g
SAN_TH = -fsanitize=thread -fno-omit-frame-pointer -g

test-ubsan:
	$(MAKE) BUILD_DIR=build-ubsan CFLAGS="$(CFLAGS) $(SAN_UB)" TEST_CFLAGS="$(TEST_CFLAGS) $(SAN_UB)" test

test-tsan:
	$(MAKE) BUILD_DIR=build-tsan CFLAGS="$(CFLAGS) $(SAN_TH)" TEST_CFLAGS="$(TEST_CFLAGS) $(SAN_TH)" test

# Benchmarks
#   make bench-mine-all   runs bench/throughput.c with my allocator and then
#                         with glibc's ptmalloc
#   make shared           builds build/liballocator.so (malloc/free/calloc/realloc
#                         wrapper), usable with LD_PRELOAD, e.g. by mimalloc-bench
#   make mimalloc-bench-setup
#                         clones mimalloc-bench into extern/mimalloc-bench (ignored by
#                         git) and builds it; runs once, then does nothing
#   make bench-mi         builds the shared library, sets up mimalloc-bench if needed,
#                         and runs its bench.sh with my allocator plus MI_ALLOCS on
#                         MI_TESTS, e.g.
#                           make bench-mi MI_TESTS="larson cfrac" MI_ALLOCS="mi sys je"
BENCH_DIR    = bench
BENCH_SRC    = $(BENCH_DIR)/throughput.c
BENCH_BIN    = $(BUILD_DIR)/throughput
WRAPPER_SRC  = $(BENCH_DIR)/wrapper.c
SHARED_LIB   = $(BUILD_DIR)/liballocator.so
BENCH_CFLAGS = -Wall -Wextra -O2 -pthread

SHARED_CFLAGS = -Wall -Wextra -O2 -pthread -fPIC -fno-semantic-interposition \
                -ftls-model=initial-exec -flto

$(SHARED_LIB): $(SRCS) $(WRAPPER_SRC) $(wildcard $(SRC_DIR)/*.h) $(wildcard $(INC_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(SHARED_CFLAGS) -shared $(SRCS) $(WRAPPER_SRC) -o $@

shared: $(SHARED_LIB)

# The benchmark is built against plain libc; the allocator is chosen at run time
$(BENCH_BIN): $(BENCH_SRC) | $(BUILD_DIR)
	$(CC) $(BENCH_CFLAGS) $< -o $@

bench-mine-all: $(BENCH_BIN) $(SHARED_LIB)
	@echo "== allocator: my =="
	LD_PRELOAD=$(abspath $(SHARED_LIB)) ./$(BENCH_BIN)
	@echo "== allocator: ptmalloc =="
	./$(BENCH_BIN)

MI_BENCH_DIR  ?= extern/mimalloc-bench
MI_BENCH_URL  ?= https://github.com/daanx/mimalloc-bench
MI_BENCH_REF  ?= master
MI_BUILD_ARGS ?= bench mi
MI_ALLOCS     ?= mi sys
MI_TESTS      ?= larson barnes espresso cfrac
MI_STAMP       = $(MI_BENCH_DIR)/.setup-done
MI_EXTERNAL    = $(BUILD_DIR)/mi-external.txt

$(MI_STAMP):
	test -d $(MI_BENCH_DIR)/.git || git clone $(MI_BENCH_URL) $(MI_BENCH_DIR)
	git -C $(MI_BENCH_DIR) checkout $(MI_BENCH_REF)
	cd $(MI_BENCH_DIR) && ./build-bench-env.sh $(MI_BUILD_ARGS)
	touch $@

mimalloc-bench-setup: $(MI_STAMP)

# My allocator is registered through bench.sh's --external file ("<name> <path>"),
# so the cloned mimalloc-bench does not need any local modification. The path is
# split on whitespace by bench.sh, so it must not contain spaces.
bench-mi: $(SHARED_LIB) $(MI_STAMP)
	@case "$(abspath $(SHARED_LIB))" in *" "*) \
		echo "error: bench.sh cannot handle spaces in '$(abspath $(SHARED_LIB))'"; exit 1;; esac
	echo "my $(abspath $(SHARED_LIB))" > $(MI_EXTERNAL)
	cd $(MI_BENCH_DIR)/out/bench && ../../bench.sh --external=$(abspath $(MI_EXTERNAL)) $(MI_ALLOCS) $(MI_TESTS)


# Header dependencies generated by -MMD
-include $(DEPS)

.PHONY: all clean test test-ubsan test-tsan shared bench-mine-all mimalloc-bench-setup bench-mi
